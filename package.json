{
  "name": "task-manager-app",
  "version": "1.0.0",
  "description": "Task Manager application built with Node.js 24 and Express 4.x",
  "main": "src/server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "test:coverage": "jest --verbose --forceExit --detectOpenHandles --coverage",
    "test:watch": "jest --watch --verbose",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/reset.js"
  },
  "keywords": [
    "todo",
    "express",
    "sqlite",
    "crud",
    "nodejs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "morgan": "^1.10.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
